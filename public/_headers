# Cloudflare Pages response headers.
# Without this file every response is "max-age=0, must-revalidate": a returning
# visitor re-checks all 120 background frames and every image on each visit.

# Vite puts a content hash in these file names, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Background frames. Not hashed: rename the folder if the footage changes.
/frames/*
  Cache-Control: public, max-age=2592000
/frames-m/*
  Cache-Control: public, max-age=2592000

# Search engines should rank the page, not its plain-text copy.
/llms-full.txt
  Link: <https://emigarciafuenzalidadesign.pages.dev/>; rel="canonical"
